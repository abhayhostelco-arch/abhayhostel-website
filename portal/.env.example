# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only leave-decision email delivery. Keep these out of client code and never commit real values.
RESEND_API_KEY=
LEAVE_EMAIL_FROM=

# Used only by `npm run bootstrap:super-admin`.
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Abhay Hostel Owner
