{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:cleanup:integration": "tsx scripts/cleanup-integration.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:secrets": "node scripts/secret-scan.mjs",
    "verify:netlify": "netlify functions:build --src netlify/functions --functions .netlify/functions-dist && node scripts/verify-netlify-functions.mjs .netlify/functions-dist",
    "verify:cleanup": "npm run test:db && npm run test:cleanup:integration && npm run verify:netlify",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run security:secrets && npm run build",
    "bootstrap:super-admin": "tsx --env-file=.env.local scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^28.1.0",
    "netlify-cli": "26.2.0",
    "supabase": "2.116.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
